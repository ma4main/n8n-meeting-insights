{
  "name": "Бэкап воркфлоу → GitHub",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "edabe291-044f-4b7a-bafd-6537610231cf",
      "name": "Каждый день 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://n8n.example.com/api/v1/workflows",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "n8nApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "250"
            }
          ]
        },
        "options": {}
      },
      "id": "a834e09d-580e-4679-af43-af90987d2a16",
      "name": "Список воркфлоу (n8n API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        464,
        304
      ],
      "credentials": {
        "n8nApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "n8n account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json || {};\nconst list = resp.data || [];\nconst repo = 'your-github-user/your-private-backup-repo';\nconst date = new Date(Date.now() + 3*3600*1000).toISOString().slice(0,10);\nconst out = [];\nfor (let i = 0; i < list.length; i++) {\n  const wf = list[i] || {};\n  if (wf.isArchived) continue;\n  const id = wf.id || ('unknown-' + i);\n  const name = wf.name || id;\n  const path = 'workflows/' + id + '.json';\n  const content = Buffer.from(JSON.stringify(wf, null, 2), 'utf8').toString('base64');\n  out.push({ json: { id: id, name: name, path: path, apiUrl: 'https://api.github.com/repos/' + repo + '/contents/' + path, message: 'backup: ' + name + ' (' + id + ') ' + date, contentB64: content } });\n}\nreturn out;"
      },
      "id": "5a4a38b4-9902-44e7-932d-b67ee6dc2e2b",
      "name": "Подготовить файлы",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.apiUrl }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "main"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-backup"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "3f2dd900-b980-4393-b025-867446af11e0",
      "name": "Узнать SHA файла",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        912,
        304
      ],
      "credentials": {
        "githubApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prep = $('Подготовить файлы').item.json;\nconst sha = ($json && typeof $json.sha === 'string' && $json.sha) ? $json.sha : '';\nconst body = { message: prep.message, content: prep.contentB64, branch: 'main' };\nif (sha) { body.sha = sha; }\nreturn { json: { apiUrl: prep.apiUrl, name: prep.name, putBody: body } };"
      },
      "id": "a11a392c-1224-4e58-a888-a0076deacd6d",
      "name": "Собрать тело PUT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        304
      ]
    },
    {
      "parameters": {},
      "id": "ff4f3914-b494-4946-a755-670b80842cd4",
      "name": "Готово",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1568,
        208
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.apiUrl }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-backup"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.putBody }}",
        "options": {}
      },
      "id": "b4b95bdd-516b-4af8-b160-73214b72da46",
      "name": "Коммит в GitHub",
