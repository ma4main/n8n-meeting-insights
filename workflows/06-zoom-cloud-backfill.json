    {
      "parameters": {
        "url": "=https://api.zoom.us/v2/users/{{ $(\"Config\").item.json.userId }}/recordings",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $(\"Config\").item.json.from }}"
            },
            {
              "name": "to",
              "value": "={{ $(\"Config\").item.json.to }}"
            },
