              "value": "300"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Get Zoom Token\").item.json.access_token }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "bce8022b-9e16-4a32-8b4c-22cd55155423",
      "name": "List Recordings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp = $('List Recordings').first().json;\nif (!resp || !Array.isArray(resp.meetings)) {\n  throw new Error('Zoom recordings: нет поля meetings (вероятно 401 / нет scope). Ответ: ' + JSON.stringify(resp).slice(0, 800));\n}\nconst token = ($('Get Zoom Token').first().json.access_token) || '';\nif (!token) { throw new Error('Zoom: пустой access_token'); }\nconst cfg = $('Config').first().json;\nconst from = cfg.from, to = cfg.to;\nconst meetings = resp.meetings;\nconst out = [];\nconst skipped = [];\nfor (const m of meetings) {\n  const startTime = m.start_time || '';\n  const day = startTime.slice(0, 10);\n  if (from && day && day < from) continue;\n  if (to && day && day > to) continue;\n  const files = m.recording_files || [];\n  let audio = files.find(function(f){ return f.file_type === 'M4A'; });\n  if (!audio) audio = files.find(function(f){ return (f.recording_type || '').indexOf('audio') >= 0; });\n  if (!audio || !audio.download_url) {\n    skipped.push((m.topic || 'без названия') + ' (' + day + ')');\n    continue;\n  }\n  const sep = audio.download_url.indexOf('?') >= 0 ? '&' : '?';\n  const audioUrl = audio.download_url + sep + 'access_token=' + token;\n  const title = (m.topic || 'Zoom Meeting') + ' — ' + day;\n  const firefliesBody = {\n    query: 'mutation UploadAudio($input: AudioUploadInput) { uploadAudio(input: $input) { success title message } }',\n    variables: { input: { url: audioUrl, title: title, custom_language: 'ru', client_reference_id: (m.uuid || '') } }\n  };\n  out.push({ json: { uuid: m.uuid || '', topic: m.topic || '', day: day, title: title, audioFound: true, firefliesBody: firefliesBody } });\n}\nconst meta = { total: meetings.length, withAudio: out.length, skipped: skipped };\nfor (const it of out) { it.json.meta = meta; }\nreturn out;"
      },
      "id": "318fed48-a9a8-4694-a2df-b59fafe5d9a3",
      "name": "Build Uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
