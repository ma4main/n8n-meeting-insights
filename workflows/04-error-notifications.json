    },
    {
      "id": "7d2a676b-02cb-4a4c-9f9b-aec46079157f",
      "name": "Build Error Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json || {};\nconst wf = (j.workflow && j.workflow.name) || 'неизвестный воркфлоу';\nconst ex = j.execution || {};\nconst lastNode = ex.lastNodeExecuted || '—';\nlet errMsg = '';\ntry { errMsg = (ex.error && (ex.error.message || ex.error.description)) || ''; } catch (e) {}\nif (!errMsg) errMsg = 'нет описания';\nconst url = ex.url || '';\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet text = '❌ Ошибка в воркфлоу\\n\\n';\ntext += 'Флоу: ' + esc(wf) + '\\n';\ntext += 'Узел: ' + esc(lastNode) + '\\n';\ntext += 'Ошибка: ' + esc(errMsg);\nif (url) text += '\\n\\n' + url;\nreturn [{ json: { msg: text } }];"
      }
    },
    {
      "id": "245db363-6978-4954-9742-46bb9151b930",
      "name": "Telegram — Ошибка",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.msg }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
